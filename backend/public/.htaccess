<IfModule mod_rewrite.c>
RewriteEngine On

# Apache CORS fallback (prefer Laravel CORS config). Requires mod_headers + AllowOverride FileInfo.
<IfModule mod_headers.c>
  Header always set Access-Control-Allow-Methods "GET, POST, OPTIONS, PUT, DELETE"
  Header always set Access-Control-Allow-Headers "Content-Type, Authorization"
</IfModule>

# Preserve Authorization header for PHP/FastCGI setups.
# Without this, Laravel Sanctum Bearer tokens may not be visible, causing 401 after login.
RewriteCond %{HTTP:Authorization} .
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# Laravel public directory should always land on index.php (not index.html).
DirectoryIndex index.php

# Standard Laravel front controller
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [L]
</IfModule>