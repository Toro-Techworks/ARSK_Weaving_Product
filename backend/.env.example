# Copy to .env on the server. Never commit real .env with secrets.
# After deploy: php artisan key:generate --force (if APP_KEY empty)
# Then: php artisan migrate --force && php artisan config:cache

BACKEND_PATH=

APP_NAME="Toro Production"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Kolkata
APP_URL=https://your-domain.example

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=your_database
DB_USERNAME=your_user
DB_PASSWORD=your_password

# Single BROADCAST_CONNECTION line (duplicates can cause confusing behaviour).
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

CACHE_STORE=file
CACHE_PREFIX=

# --- Sanctum / SPA (Bearer token API) ---
# React sends Authorization: Bearer <token>. Leave SANCTUM_STATEFUL_DOMAINS empty.
# Only set stateful domains + SESSION_DOMAIN if you use cookie + CSRF SPA mode.
SANCTUM_STATEFUL_DOMAINS=
SPA_URL=https://your-frontend.example
CORS_ORIGINS=https://your-frontend.example,http://localhost:5173
# SESSION_DOMAIN=

# Pusher (optional; set BROADCAST_CONNECTION=pusher when used)
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=ap2
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https

# Temporary debugging (disable in production after fixing issues)
# APP_DEBUG=true
